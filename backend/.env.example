# Django settings
SECRET_KEY=django-insecure-dummy-key-for-dev
DEBUG=True

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Apache Ozone S3 Gateway Configuration
MLFLOW_S3_ENDPOINT_URL=http://localhost:9878
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
OZONE_BUCKET=ml-models
MLFLOW_S3_IGNORE_TLS=true

# Rollout configuration
ROLLOUT_STEP_SIZE=10
ROLLOUT_INTERVAL_SECONDS=5
ROLLOUT_ERROR_THRESHOLD=0.20
