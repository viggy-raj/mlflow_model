from minio import Minio
from minio.error import S3Error
import os
from dotenv import load_dotenv

# loading .env
load_dotenv()
MINIO_ENDPOINT = os.getenv("MINIO_ENDPOINT", "localhost:9000")
MINIO_ACCESS_KEY = os.getenv("MINIO_ACCESS_KEY", "minioadmin")
MINIO_SECRET_KEY = os.getenv("MINIO_SECRET_KEY", "minioadmin")
BUCKET_NAME = os.getenv("BUCKET_NAME", "mlflow-models")

class MinioStorageService:
    """Service class for handling MinIO interactions."""
    
    def __init__(self, endpoint, access_key, secret_key, bucket_name, secure=True):
        self.endpoint = endpoint
        self.access_key = access_key
        self.secret_key = secret_key
        self.bucket_name = bucket_name
        self.client = Minio(
            self.endpoint,
            access_key=self.access_key,
            secret_key=self.secret_key,
            secure=secure,
            cert_check=False,
        )

    def upload_model(self, model_file, object_name):
        """Uploads a model artifact to MinIO."""
        try:
            result = self.client.put_object(
                bucket_name=self.bucket_name,
                object_name=object_name,
                data=model_file,
                length=model_file.size,
                content_type="application/octet-stream",
            )
            return {
                "success": True,
                "object_name": result.object_name,
                "etag": result.etag,
            }
        except S3Error as e:
            return {
                "success": False,
                "error": str(e),
            }

    def delete_model(self, object_name):
        """Deletes a model artifact from MinIO."""
        try:
            self.client.remove_object(
                bucket_name=self.bucket_name,
                object_name=object_name,
            )
            return {"success": True}
        except S3Error as e:
            return {"success": False, "error": str(e)}

    def list_models(self):
        """Lists all model objects stored in MinIO under the 'models/' prefix."""
        try:
            objects = self.client.list_objects(
                bucket_name=self.bucket_name,
                prefix="models/",
                recursive=True,
            )
            models = [
                {
                    "object_name": obj.object_name,
                    "size_bytes": obj.size,
                    "last_modified": obj.last_modified.isoformat() if obj.last_modified else None,
                    "etag": obj.etag,
                }
                for obj in objects
            ]
            return {
                "success": True,
                "models": models,
                "count": len(models),
            }
        except S3Error as e:
            return {
                "success": False,
                "error": str(e),
            }

# Instantiate a default service object
storage_service = MinioStorageService(
    MINIO_ENDPOINT, 
    MINIO_ACCESS_KEY, 
    MINIO_SECRET_KEY, 
    BUCKET_NAME
)